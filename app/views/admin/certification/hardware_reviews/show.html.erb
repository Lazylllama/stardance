<% content_for :title, "Hardware review: #{@project.title}" %>

<%
  active_status = @active_review&.status || "idle"
  funding_can_review = @active_review_type == :funding && @funding_request.claim_held_by?(current_user)
  ship_can_review = @active_review_type == :ship && @ship.claim_held_by?(current_user)
  can_review = funding_can_review || ship_can_review
  stage_label = @active_review_type == :funding ? "Design funding" : "Build certification"
  queue_path = hardware_queue_path(@active_review_type == :ship ? "build" : "design")
%>

<div class="app-layout app-layout--wide"
     data-controller="certification--queue"
     data-certification--queue-server-now-value="<%= Time.current.iso8601 %>">
  <div class="app-layout__main app-layout__main--wide ship-review hardware-review">
    <%= link_to "← back to #{@active_review_type == :ship ? "build" : "design"} queue", queue_path,
          class: "ship-review__back" %>

    <%# Everything needed to start deciding, in one band: what it is, who it's
        from, and the number the verdict turns on. %>
    <header class="hardware-review__header">
      <div class="ship-review__title">
        <h1><%= @project.title %></h1>
        <span class="ship-review__id">#<%= @project.id %></span>
        <span class="status-pill status-pill--<%= active_status %>"><%= active_status.to_s.capitalize %></span>
        <% if @active_review %>
          <span class="hardware-review__tag"><%= stage_label %></span>
        <% end %>
      </div>

      <% if @active_review %>
        <%= render "admin/certification/hardware_reviews/review_facts", project: @project, owner: @owner,
              review: @active_review, review_type: @active_review_type %>
      <% end %>

      <%# Compact link row rather than a definition list further down the page. %>
      <div class="hardware-review__links">
        <% if (safe_repo_url = safe_external_url(@project.repo_url)) %>
          <%= link_to "Repo ↗", safe_repo_url, class: "hardware-review__link", target: "_blank", rel: "noopener noreferrer" %>
        <% end %>
        <% if (safe_demo_url = safe_external_url(@project.demo_url)) %>
          <%= link_to "Demo ↗", safe_demo_url, class: "hardware-review__link", target: "_blank", rel: "noopener noreferrer" %>
        <% end %>
        <% if (safe_readme_url = safe_external_url(@project.readme_url)) %>
          <%= link_to "Readme ↗", safe_readme_url, class: "hardware-review__link", target: "_blank", rel: "noopener noreferrer" %>
        <% end %>
        <%= link_to "Project page ↗", project_path(@project), class: "hardware-review__link", target: "_blank", rel: "noopener" %>
      </div>
    </header>

    <div class="ship-review__body hardware-review__body">
      <section class="ship-review__details">
        <% if @project.description.present? %>
          <div class="ship-review__panel">
            <h2 class="ship-review__panel-title">What they're building</h2>
            <p class="ship-review__description"><%= @project.description %></p>
          </div>
        <% end %>

        <%= render "admin/certification/funding_requests/recordings",
              timelapses: @lapse_timelapses, recordings: @lookout_recordings %>

        <%# Secondary context: useful when a verdict is borderline, not needed to
            start reviewing, so it sits below the evidence and the form. %>
        <details class="hardware-review__more">
          <summary>More context</summary>

          <div class="ship-review__panel">
            <h2 class="ship-review__panel-title">Hardware pipeline</h2>
            <div class="hardware-review__timeline">
              <div class="hardware-review__timeline-item">
                <span class="hardware-review__timeline-label">Design funding</span>
                <% if @funding_request %>
                  <span class="status-pill status-pill--<%= @funding_request.status %>"><%= @funding_request.status.capitalize %></span>
                  <span class="hardware-review__timeline-meta">
                    <% if @funding_request.awards_design_kit? %>
                      <%= @funding_request.design_kit_shop_item&.name || "Kit" %>
                    <% else %>
                      $<%= @funding_request.final_amount_dollars %>
                      <% if @funding_request.approved? %> approved<% elsif @funding_request.pending? %> requested<% end %>
                    <% end %>
                  </span>
                <% else %>
                  <span class="hardware-review__timeline-meta">Skipped</span>
                <% end %>
              </div>
              <div class="hardware-review__timeline-item">
                <span class="hardware-review__timeline-label">Build certification</span>
                <% if @ship %>
                  <span class="status-pill status-pill--<%= @ship.status %>"><%= @ship.status.capitalize %></span>
                  <% if @ship.decided_at %>
                    <span class="hardware-review__timeline-meta"><%= l(@ship.decided_at.to_date, format: :short) %></span>
                  <% end %>
                <% elsif @project.build_stage? %>
                  <span class="hardware-review__timeline-meta">Waiting for ship</span>
                <% else %>
                  <span class="hardware-review__timeline-meta">Not reached yet</span>
                <% end %>
              </div>
            </div>
          </div>

          <% if @past_reviews.any? %>
            <div class="ship-review__panel">
              <h2 class="ship-review__panel-title">Previous reviews</h2>
              <ul class="hardware-review__history">
                <% @past_reviews.each do |review| %>
                  <% is_funding = review.is_a?(::Certification::FundingRequest) %>
                  <li class="hardware-review__history-item">
                    <div class="hardware-review__history-head">
                      <span class="hardware-review__timeline-label"><%= is_funding ? "Design funding" : "Build certification" %></span>
                      <span class="status-pill status-pill--<%= review.status %>"><%= review.status.capitalize %></span>
                      <% if is_funding %>
                        <span class="hardware-review__timeline-meta">
                          <%= review.awards_design_kit? ? (review.design_kit_shop_item&.name || "Kit") : "$#{review.final_amount_dollars} · #{review.tier_label}" %>
                        </span>
                      <% end %>
                      <% if review.decided_at %>
                        <span class="hardware-review__timeline-meta"><%= l(review.decided_at.to_date, format: :short) %></span>
                      <% end %>
                      <% if review.reviewer %>
                        <span class="hardware-review__timeline-meta">by <%= review.reviewer.display_name %></span>
                      <% end %>
                    </div>
                    <% if review.feedback.present? %>
                      <p class="hardware-review__history-feedback"><%= review.feedback %></p>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if @active_review_type == :ship && @project.update_description.present? %>
            <div class="ship-review__panel">
              <h2 class="ship-review__panel-title">Update notes</h2>
              <p class="ship-review__description"><%= @project.update_description %></p>
            </div>
          <% end %>

          <% if @project.ai_declaration.present? %>
            <div class="ship-review__panel">
              <h2 class="ship-review__panel-title">AI declaration</h2>
              <p class="ship-review__description"><%= @project.ai_declaration %></p>
            </div>
          <% end %>

          <% if @active_review&.reviewer %>
            <div class="ship-review__panel">
              <h2 class="ship-review__panel-title">Claimed by</h2>
              <p class="ship-review__description"><%= @active_review.reviewer.display_name %></p>
            </div>
          <% end %>
        </details>
      </section>

      <aside class="ship-review__sidebar hardware-review__sidebar">
        <%# The verdict form is the point of the page, so it leads the sidebar
            once claimed; the claim prompt takes its place when it isn't. %>
        <% if @active_review_type == :funding && @funding_request.pending? && funding_can_review %>
          <%= render "admin/certification/funding_requests/form", funding_request: @funding_request, redirect_to_hardware: true %>
        <% elsif @active_review_type == :ship && @ship.pending? && ship_can_review %>
          <%= render "admin/certification/ships/form", ship: @ship, can_review: ship_can_review, redirect_to_hardware: true %>
        <% elsif @active_review_type == :funding %>
          <div class="ship-review__claim">
            <p>You don't currently hold the claim on this review.</p>
            <%= button_to "Claim this review", admin_certification_funding_request_claim_path(@funding_request),
                  method: :post, params: { redirect_to_hardware: @project.id },
                  class: "action-btn action-btn--large action-btn--primary" %>
          </div>
        <% elsif @active_review_type == :ship %>
          <div class="ship-review__claim">
            <p>You don't currently hold the claim on this review.</p>
            <%= button_to "Claim this review", admin_certification_ship_claim_path(@ship),
                  method: :post, params: { redirect_to_hardware: @project.id },
                  class: "action-btn action-btn--large action-btn--primary" %>
          </div>
        <% else %>
          <div class="ship-review__panel">
            <p class="ship-review__description">Nothing is pending review on this hardware project.</p>
            <%= link_to "Back to the queue", queue_path, class: "action-btn action-btn--small action-btn--secondary" %>
          </div>
        <% end %>

        <% if can_review %>
          <div class="ship-review__panel hardware-review__secondary-actions">
            <% if @active_review_type == :ship && @ship.pending? %>
              <%= form_with url: set_project_type_admin_certification_ship_path(@ship), method: :patch do %>
                <%= hidden_field_tag :redirect_to_hardware, @project.id %>
                <%= label_tag :project_type, "Project type", class: "ship-review__panel-title" %>
                <%= select_tag :project_type,
                      options_for_select(
                        [ [ "Unknown", nil, { disabled: true, hidden: @project.project_type.present? } ], *Project::AVAILABLE_CATEGORIES.map { |t| [ t, t ] } ],
                        @project.project_type
                      ),
                      onchange: "this.form.requestSubmit()",
                      class: "ship-queue__select" %>
              <% end %>
            <% end %>
            <button type="submit" form="unclaim-form-<%= @active_review.id %>"
                    class="action-btn action-btn--small action-btn--destructive">
              Unclaim review
            </button>
          </div>
        <% end %>

        <% unless @active_review %>
          <div class="ship-review__verdict-card">
            <h2 class="ship-review__panel-title">Latest verdicts</h2>
            <% if @funding_request&.feedback.present? %>
              <div class="ship-review__verdict-feedback">
                <h3>Funding feedback</h3>
                <p><%= @funding_request.feedback %></p>
              </div>
            <% end %>
            <% if @ship&.feedback.present? %>
              <div class="ship-review__verdict-feedback">
                <h3>Build feedback</h3>
                <p><%= @ship.feedback %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </aside>
    </div>
  </div>
</div>
