<%
  # Impact first, then momentum, then where you sit in the crew this week. Each
  # tile is { value:, label:, note: } so the grid stays one loop.
  best_day = progress[:best_day]
  rank     = progress[:rank]

  stats = [
    { value: number_with_delimiter(progress[:hours_certified]),
      label: "Hours certified",
      note: "of building, signed off by you" },
    { value: number_with_delimiter(progress[:people_reviewed]),
      label: "People's projects you've reviewed",
      note: "different people, all time" },
    { value: progress[:streak],
      label: "Day streak",
      note: "days in a row with a review" },
    { value: progress[:best_day_devlogs] || 0,
      label: "Best day",
      note: best_day ? "your record, set #{best_day.strftime('%-m/%-d')}" : "no reviews yet" },
    { value: "#{number_with_precision(progress[:share_of_week], precision: 0)}%",
      label: "Share this week",
      note: "of every devlog the crew reviewed" },
    { value: rank ? "##{rank}" : "—",
      label: "Rank this week",
      note: rank ? "of #{pluralize(progress[:crew_size], 'reviewer')}" : "review one to get ranked" }
  ]
%>

<section class="ysws-dashboard__progress" aria-labelledby="ysws-progress-heading">
  <h3 class="ysws-dashboard__heading" id="ysws-progress-heading">See your progress</h3>

  <%= tag.div class: [ "ysws-dashboard__progress-hero", ("ysws-dashboard__progress-hero--on-pace" if progress[:on_pace]) ],
              role: "status", aria: { live: "polite" } do %>
    <p class="ysws-dashboard__progress-primary">
      <span class="ysws-dashboard__progress-count">
        <%= number_with_precision progress[:pace][:daily_average], precision: 1, strip_insignificant_zeros: true %>
      </span>
      <span class="ysws-dashboard__progress-label">devlogs / day this week</span>
    </p>

    <p class="ysws-dashboard__progress-note">
      <% if progress[:on_pace] %>
        On pace — <%= ::Certification::Ysws::DEVLOG_REVIEW_GOAL_PER_DAY %>/day average met
      <% else %>
        <%= pluralize progress[:pace][:needed_today], "more" %> today to reach your goal!
      <% end %>
    </p>
  <% end %>

  <dl class="ysws-dashboard__progress-stats">
    <% stats.each do |stat| %>
      <div class="ysws-dashboard__progress-stat">
        <dt class="ysws-dashboard__progress-stat-label"><%= stat[:label] %></dt>
        <dd class="ysws-dashboard__progress-stat-value"><%= stat[:value] %></dd>
        <dd class="ysws-dashboard__progress-stat-note"><%= stat[:note] %></dd>
      </div>
    <% end %>
  </dl>

  <% if (tier = progress[:next_tier]) %>
    <div class="ysws-dashboard__progress-tier">
      <p class="ysws-dashboard__progress-tier-note">
        <strong><%= number_with_delimiter progress[:lifetime_devlogs] %></strong> devlogs reviewed, all time —
        <%= pluralize number_with_delimiter(tier[:devlogs_needed]), "more" %>
        to earn <%= tier[:rate] %> ✦ each, up from <%= tier[:current_rate] %> ✦.
      </p>
      <div class="ysws-dashboard__progress-tier-track" style="--tier-fill: <%= tier[:percent] %>%"
           role="progressbar" aria-valuenow="<%= tier[:percent] %>" aria-valuemin="0" aria-valuemax="100"
           aria-label="Progress to the next stardust rate">
        <div class="ysws-dashboard__progress-tier-fill"></div>
      </div>
    </div>
  <% else %>
    <p class="ysws-dashboard__progress-tier-note">
      <strong><%= number_with_delimiter progress[:lifetime_devlogs] %></strong> devlogs reviewed, all time —
      you're on the top stardust rate.
    </p>
  <% end %>
</section>
