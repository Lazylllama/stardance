<% content_for :title, "Votes on #{@project.title}" %>
<h1 align="center">Votes on <%= @project.title %> (#<%= @project.id %>)</h1>

<div>
  <%= link_to "← Back to Project", admin_project_path(@project) %>
  <label>
    <input type="checkbox" id="toggle-reasons" checked>
    Show vote reasons
  </label>
  <label>
    <input type="checkbox" id="toggle-discarded" checked>
    Show discarded votes (<%= @project.votes.discarded_count %>)
  </label>
  <label>
    <input type="checkbox" id="toggle-last-ship">
    Show only last ship
  </label>
</div>

<% if @ship_event_payouts.present? %>
  <div>
    <strong>Estimated payouts:</strong>
    <ul>
      <% @ship_event_payouts.each do |ship_event, preview| %>
        <li>
          <% if policy(@project).view_payout_reviews? %>
            <%= link_to "Ship ##{ship_event.id}", admin_payout_review_path(ship_event) %>
          <% else %>
            Ship #<%= ship_event.id %>
          <% end %>
          (<%= ship_event.payout_recipient&.display_name || "Unknown" %>):
          <strong><%= preview[:estimated_payout] || "—" %> stardust</strong>
          <% if preview[:estimated_payout] && preview[:hours].to_f.positive? %>
            <span>(<%= number_with_precision(preview[:estimated_payout] / preview[:hours], precision: 1) %> stardust/hr)</span>
          <% end %>
          <% if ship_event.payout.present? %>
            <span>— already paid <%= ship_event.payout %> stardust</span>
          <% else %>
            <span>
              (<%= preview[:votes_count] %>/<%= Post::ShipEvent::VOTES_REQUIRED_FOR_PAYOUT %> votes,
              <%= preview[:percentile] ? "#{number_with_precision(preview[:percentile], precision: 1)}th percentile" : "no percentile yet" %>)
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div>
  <% if @votes.any? %>
    <table>
      <thead>
        <tr>
          <th>Ship ID</th>
          <th>Time</th>
          <th>Voter</th>
          <th>Orig.</th>
          <th>Tech.</th>
          <th>Usab.</th>
          <th>Story.</th>
          <th>Status</th>
          <th>Reason</th>
        </tr>
      </thead>
      <tbody>
        <% @votes.each do |vote| %>
          <tr>
            <td><%= vote.ship_event_id %></td>
            <td><%= time_ago_in_words(vote.created_at) %> ago</td>
            <td>
              <% if vote.user %>
                <%= link_to vote.user.display_name || "User ##{vote.user.id}", admin_user_path(vote.user) %>
              <% else %>
                <span>Unknown</span>
              <% end %>
            </td>
            <td><%= vote.originality_score || "—" %></td>
            <td><%= vote.technical_score || "—" %></td>
            <td><%= vote.usability_score || "—" %></td>
            <td><%= vote.storytelling_score || "—" %></td>
            <td><%= vote.discarded? ? "Discarded" : "Counted" %></td>
            <td class="vote-reasons">
              <% if vote.reason.present? %>
                <details>
                  <summary>View</summary>
                  <div><%= vote.reason %></div>
                </details>
              <% else %>
                <span>—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td>
            <strong>Median scores (of counted votes):</strong>
          </td>
          <td/><td/>
          <% @score_medians.each do |category, median| %>
          <td>
            <span>(<%= median || "—" %>)</span>
          </td>
          <% end %>
        </tr>
      </tfoot>
    </table>
    <% if @pagy.pages > 1 %>
      <div>
        <%== @pagy.series_nav %>
      </div>
    <% end %>
  <% else %>
    <p>No votes received yet.</p>
  <% end %>
</div>

<script>
  (function() {
    const toggleReasons = document.getElementById("toggle-reasons");
    const toggleDiscarded = document.getElementById("toggle-discarded");
    const ToggleLastShip = document.getElementById("toggle-last-ship");


    if (toggleDiscarded  || ToggleLastShip) {
      const setVisibility = () => {
        const lastShipId = <%= @project.ship_events.maximum(:id) || "null" %>;
        document.querySelectorAll("tr").forEach((row) => {
          const statusCell = row.querySelector("td:nth-child(8)");
          const shipIdCell = row.querySelector("td:nth-child(1)");

          if (toggleDiscarded.checked && statusCell && statusCell.textContent.trim() === "Discarded") {
            row.style.display = "";
          } else if (!toggleDiscarded.checked && statusCell && statusCell.textContent.trim() === "Discarded") {
            row.style.display = "none";
          } else if (ToggleLastShip.checked && shipIdCell && shipIdCell.textContent.trim() !== lastShipId?.toString() && !shipIdCell.textContent.trim().includes("Median")) {
            row.style.display = "none";
          } else {
            row.style.display = "";
          }
        });
      };

      setVisibility();

      toggleDiscarded.addEventListener("change", function() {
        setVisibility();
      });
      ToggleLastShip.addEventListener("change", function() {
        setVisibility();
      });
    }

    if (toggleReasons) {
      const setReasonsExpanded = (expanded) => {
        document.querySelectorAll("td.vote-reasons details").forEach((details) => {
          details.open = expanded;
        });
      };

      setReasonsExpanded(toggleReasons.checked);
      toggleReasons.addEventListener("change", function() {
        setReasonsExpanded(this.checked);
      });
    };
  })();
</script>
