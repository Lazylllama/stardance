<% if attachments.any? %>
  <div class="feed-post-card__media" data-controller="post-attachments">
    <div class="feed-post-card__media-viewport">
      <button type="button" class="feed-post-card__chevron feed-post-card__chevron--prev" data-post-attachments-target="prevButton" data-action="post-attachments#prev" aria-label="Previous" hidden>
        <%= inline_svg_tag "icons/chevron-down.svg", class: "feed-post-card__chevron-icon", focusable: "false", aria: { hidden: true } %>
      </button>
      <div class="feed-post-card__media-track" data-post-attachments-target="track">
        <% attachments.each_with_index do |attachment, index| %>
          <figure class="feed-post-card__media-slide">
            <% if attachment.variable? %>
              <%= image_tag attachment.variant(:large), alt: "", class: "feed-post-card__image" %>
            <% elsif attachment.content_type.to_s.start_with?("image/") %>
              <%= image_tag attachment, alt: "", class: "feed-post-card__image" %>
            <% elsif attachment.content_type.to_s.start_with?("video/") %>
              <%= video_tag url_for(attachment), controls: true, class: "feed-post-card__video" %>
            <% else %>
              <%= link_to attachment.filename.to_s, url_for(attachment), class: "feed-post-card__file" %>
            <% end %>
          </figure>
        <% end %>
      </div>
      <button type="button" class="feed-post-card__chevron feed-post-card__chevron--next" data-post-attachments-target="nextButton" data-action="post-attachments#next" aria-label="Next" hidden>
        <%= inline_svg_tag "icons/chevron-down.svg", class: "feed-post-card__chevron-icon", focusable: "false", aria: { hidden: true } %>
      </button>
      <div class="feed-post-card__indicators" data-post-attachments-target="indicators" hidden></div>
    </div>
  </div>
<% end %>
