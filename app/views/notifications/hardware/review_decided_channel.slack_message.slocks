emoji = approved ? ":white_check_mark:" : ":pencil:"
verdict = approved ? "approved" : "returned"

owner_mention = owner_slack_id.present? ? "<@#{owner_slack_id}>" : "the owner"
reviewer_mention = reviewer_slack_id.present? ? "<@#{reviewer_slack_id}>" : reviewer_name

section "#{emoji} *#{review_type} review #{verdict}:* *<#{project_url}|#{project_title}>* (#{owner_mention}) by #{reviewer_mention}", markdown: true

section "*Feedback:* #{feedback}", markdown: true if feedback.present?
