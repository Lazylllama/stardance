emoji = ":stardance_star:"
verdict = approved ? "approved" : "returned"

owner_mention = owner_slack_id.present? ? "<@#{owner_slack_id}>" : "author"
reviewer_mention = reviewer_slack_id.present? ? "<@#{reviewer_slack_id}>" : reviewer_name

section "#{emoji} brand new #{review_type} review!! :yay:

 *#{verdict}:* *<#{project_url}|#{project_title}>* by (#{owner_mention})!", markdown: true

section "feedback from #{reviewer_mention}: #{feedback}", markdown: true if feedback.present?
